{
  "name": "oxc-angular-repro-dts-chunks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:as-asset": "AS_ASSET=1 vite build",
    "consumer": "ngc -p consumer/tsconfig.json",
    "repro": "npm run build && node check.mjs && npm run consumer",
    "repro:as-asset": "npm run build:as-asset && node check.mjs && npm run consumer"
  },
  "devDependencies": {
    "@angular/compiler": "22.2.5",
    "@angular/compiler-cli": "22.2.5",
    "@angular/core": "22.2.5",
    "@oxc-angular/vite": "0.0.43",
    "rolldown-plugin-dts": "0.30.0",
    "rxjs": "^7.8.0",
    "typescript": "~6.0.3",
    "vite": "8.3.4"
  }
}
